{
  "id": "orbit",
  "name": "Orbit",
  "description": "Files & cloud storage",
  "route": "/orbit",
  "icon": "M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75z",
  "category": "storage",
  "hub": { "showInSidebar": true, "showOnDashboard": true },
  "nginx": {
    "routes": [
      { "path": "/orbit-uploads", "upstream": "minio:9000", "cors": true },
      { "path": "/orbit", "upstream": "orbit-client:5177", "websocket": true },
      { "path": "/api/orbit", "upstream": "orbit-server:3003", "maxBodySize": "0" }
    ]
  },
  "server": {
    "service": "orbit-server",
    "port": 3003,
    "env": {
      "MONGODB_URI": "mongodb://mongo:27017/nucleus",
      "MINIO_ENDPOINT": "minio",
      "MINIO_PORT": "9000",
      "MINIO_ACCESS_KEY": "${MINIO_ACCESS_KEY:-nucleusadmin}",
      "MINIO_SECRET_KEY": "${MINIO_SECRET_KEY:-nucleuschangeme}",
      "MINIO_PUBLIC_URL": "${MINIO_PUBLIC_URL:-http://localhost}",
      "MINIO_BUCKET": "${MINIO_BUCKET:-orbit-uploads}"
    },
    "depends": ["mongo", "minio"],
    "healthEndpoint": "/api/orbit/health",
    "startPeriod": "15s"
  }
}
